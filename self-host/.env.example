# ─────────────────────────────────────────────────────────────────────────
# FenceHole Hub — self-host environment.
# Copy this to ".env" (in this self-host/ folder) and fill it in.
# Most Supabase values come from THIS file too — keep them in sync with
# the supabase/docker/.env that setup.sh creates.
# ─────────────────────────────────────────────────────────────────────────

# --- How the app reaches Supabase ---
# On the SAME machine, the browser hits the API gateway on port 8000.
# Replace localhost with your server's LAN IP or hostname if you browse
# the Hub from another device (e.g. http://192.168.1.50:8000).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# These two are generated from your JWT secret (setup.sh prints them).
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-key-from-setup
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-from-setup

# --- AI brain (needs internet) ---
# Nessie routes to GLM 5.2 / Qwen via OpenRouter. Get a key at openrouter.ai
OPENROUTER_API_KEY=your-openrouter-key

# Voice-note transcription for WhatsApp — console.groq.com
GROQ_API_KEY=your-groq-key

# --- WhatsApp via Twilio (needs internet) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_ALLOWED_NUMBERS=whatsapp:+15551234567
CHRIS_WHATSAPP_NUMBER=whatsapp:+15551234567

# --- Secrets for inbound webhooks / crons ---
CRON_SECRET=
ZAPIER_WEBHOOK_SECRET=
