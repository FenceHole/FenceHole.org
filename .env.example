NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Supabase → Settings → API → service_role). Lets the
# WhatsApp webhook and cron jobs read/write agent memory without a login.
# Keep this secret — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Router / Hermes Coordinator — get a key at openrouter.ai
OPENROUTER_API_KEY=your-openrouter-key

# Free Whisper transcription for WhatsApp voice notes — get a key at console.groq.com
GROQ_API_KEY=your-groq-key

# WhatsApp via Twilio — twilio.com/console, then Messaging → Try WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Comma-separated WhatsApp numbers allowed to talk to Nessie, e.g. whatsapp:+15551234567,whatsapp:+15557654321
WHATSAPP_ALLOWED_NUMBERS=

# Where morning briefings / evening recaps get sent
CHRIS_WHATSAPP_NUMBER=whatsapp:+15551234567

# Secret Vercel Cron sends as "Authorization: Bearer <value>" — set in Vercel project settings
CRON_SECRET=

# Shared secret for the Zapier/Plaud inbound webhook (?secret=...)
ZAPIER_WEBHOOK_SECRET=

# Public base URL of the site — used to build OAuth redirect URLs.
NEXT_PUBLIC_SITE_URL=https://fencehole.org

# Google (Gmail + Calendar in the Hub). Create an OAuth client at
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorized redirect URI:
#   https://fencehole.org/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional - only if your redirect URI differs from <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_REDIRECT_URI=
